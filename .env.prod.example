# 复制为 .env.prod（已在 .gitignore 里，不会被提交）。docker-compose.prod.yml 的 api 服务用
# env_file 读取本文件；变量名用双下划线映射 .NET 的嵌套配置键（Supabase__Username = Supabase:Username）。

# Supabase Postgres 账密（和本地开发 dotnet user-secrets 里的 Supabase:Username/Password 是同一对，
# 见 appsettings.Development.json 顶部注释、ConnectionStringCredentials.cs）。
Supabase__Username=
Supabase__Password=

# 各 LLM Provider 的 API Key（和本地开发 user-secrets 里的 Llm:*:ApiKey 是同一批）。
Llm__Claude__ApiKey=
Llm__OpenAi__ApiKey=
Llm__DeepSeek__ApiKey=
Llm__Mimo__ApiKey=

# 仅当 Claude Key 是 identity-linked 类型时必填——缺了这个头，identity-linked key 的请求会直接
# 401（ClaudeApiOptions.cs 注释记录过 2026-08-29 真实踩过一次）。老式 workspace-less key 可以留空。
Llm__Claude__WorkspaceId=

# Cloudflare Zero Trust → Networks → Tunnels → 新建一个 tunnel → 选 Docker 作为连接方式，
# 面板会给一条 `cloudflared tunnel run --token eyJ...` 命令，把 --token 后面那串复制到这里。
# 同一个面板里把 Public Hostname 配置为 api.<你的域名> → HTTP → api:8080
# （"api:8080" 是 compose 网络内部地址，不是公网地址；cloudflared 和 api 两个容器在同一个
# compose 网络里，用服务名互相寻址）。
TUNNEL_TOKEN=
