<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Common\" />
  </ItemGroup>

  <!-- Hand-authored DB scripts + their apply-order manifest, embedded so SqlScriptRunner
       can read them at runtime (they are NOT EF migrations and nothing else references them). -->
  <ItemGroup>
    <None Remove="Persistence\Sql\*.sql" />
    <None Remove="Persistence\Sql\_manifest.txt" />
    <None Remove="Persistence\Sql\_bootstrap_skip.txt" />
    <EmbeddedResource Include="Persistence\Sql\*.sql" />
    <EmbeddedResource Include="Persistence\Sql\_manifest.txt" />
    <EmbeddedResource Include="Persistence\Sql\_bootstrap_skip.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.0" />
    <PackageReference Include="Scriban" Version="7.2.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepLearning.Domain\DeepLearning.Domain.csproj" />
    <ProjectReference Include="..\DeepLearning.Application\DeepLearning.Application.csproj" />
  </ItemGroup>

</Project>
